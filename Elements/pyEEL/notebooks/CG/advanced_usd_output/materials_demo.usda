#usda 1.0
(
    doc = """Generated from Composed Stage of root layer 
"""
    upAxis = "Y"
)

def Scope "Materials"
{
    def Material "SimpleMaterial"
    {
        token outputs:surface.connect = </Materials/SimpleMaterial/PreviewShader.outputs:surface>

        def Shader "PreviewShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.2, 0.2)
            float inputs:metallic = 0
            float inputs:roughness = 0.4
            token outputs:surface
        }
    }

    def Material "MetalMaterial"
    {
        token outputs:surface.connect = </Materials/MetalMaterial/PreviewShader.outputs:surface>

        def Shader "PreviewShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.7, 0.7, 0.8)
            float inputs:metallic = 1
            float inputs:roughness = 0.2
            token outputs:surface
        }
    }

    def Material "GlassMaterial"
    {
        token outputs:surface.connect = </Materials/GlassMaterial/PreviewShader.outputs:surface>

        def Shader "PreviewShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.9, 1)
            float inputs:ior = 1.5
            float inputs:metallic = 0
            float inputs:opacity = 0.3
            float inputs:roughness = 0
            token outputs:surface
        }
    }

    def Material "EmissiveMaterial"
    {
        token outputs:surface.connect = </Materials/EmissiveMaterial/PreviewShader.outputs:surface>

        def Shader "PreviewShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 0.8, 0.2)
            color3f inputs:emissiveColor = (1, 0.8, 0.2)
            float inputs:roughness = 0.5
            token outputs:surface
        }
    }

    def Material "GroundMaterial"
    {
        token outputs:surface.connect = </Materials/GroundMaterial/PreviewShader.outputs:surface>

        def Shader "PreviewShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.3, 0.3, 0.3)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }
}

def Xform "World"
{
    def Sphere "Sphere" (
        apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/SimpleMaterial>
        double3 xformOp:translate = (-4, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Cube" (
        apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/MetalMaterial>
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cylinder" (
        apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/GlassMaterial>
        double3 xformOp:translate = (4, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "LightSphere" (
        apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/EmissiveMaterial>
        float3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (0, 4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "Ground" (
        apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-10, 0, -10), (10, 0, 10)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </Materials/GroundMaterial>
        point3f[] points = [(-10, 0, -10), (10, 0, -10), (10, 0, 10), (-10, 0, 10)]
    }
}

