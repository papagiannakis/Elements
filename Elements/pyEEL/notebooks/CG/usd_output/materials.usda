#usda 1.0
(
    upAxis = "Y"
)

def Xform "Materials"
{
    def Material "RedPlastic"
    {
        token outputs:surface.connect = </Materials/RedPlastic/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.3
            token outputs:surface
        }
    }

    def Sphere "Sphere1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/RedPlastic>
        double radius = 1
        double3 xformOp:translate = (-6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "GoldMetal"
    {
        token outputs:surface.connect = </Materials/GoldMetal/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 0.84, 0)
            float inputs:metallic = 1
            float inputs:opacity = 1
            float inputs:roughness = 0.2
            token outputs:surface
        }
    }

    def Sphere "Sphere2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/GoldMetal>
        double radius = 1
        double3 xformOp:translate = (-3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "RoughGreen"
    {
        token outputs:surface.connect = </Materials/RoughGreen/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.2, 0.8, 0.2)
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.9
            token outputs:surface
        }
    }

    def Sphere "Sphere3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/RoughGreen>
        double radius = 1
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "Glass"
    {
        token outputs:surface.connect = </Materials/Glass/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.9, 1)
            float inputs:metallic = 0
            float inputs:opacity = 0.3
            float inputs:roughness = 0
            token outputs:surface
        }
    }

    def Sphere "Sphere4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/Glass>
        double radius = 1
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "Chrome"
    {
        token outputs:surface.connect = </Materials/Chrome/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.7, 0.7, 0.7)
            float inputs:metallic = 1
            float inputs:opacity = 1
            float inputs:roughness = 0.1
            token outputs:surface
        }
    }

    def Sphere "Sphere5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/Chrome>
        double radius = 1
        double3 xformOp:translate = (6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "GroundMat"
    {
        token outputs:surface.connect = </Materials/GroundMat/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }

    def Cube "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/GroundMat>
        double size = 1
        float3 xformOp:scale = (20, 0.1, 10)
        double3 xformOp:translate = (0, -1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }
}

