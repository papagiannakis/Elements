#usda 1.0
(
    upAxis = "Y"
)

def Xform "Primitives"
{
    def Sphere "Sphere"
    {
        color3f[] primvars:displayColor = [(1, 0, 0)]
        double radius = 1
        double3 xformOp:translate = (-7.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Cube"
    {
        color3f[] primvars:displayColor = [(0, 1, 0)]
        double size = 2
        double3 xformOp:translate = (-4.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cylinder"
    {
        double height = 2
        color3f[] primvars:displayColor = [(0, 0, 1)]
        double radius = 1
        double3 xformOp:translate = (-1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "Cone"
    {
        double height = 2
        color3f[] primvars:displayColor = [(1, 1, 0)]
        double radius = 1
        double3 xformOp:translate = (1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "Capsule"
    {
        double height = 2
        color3f[] primvars:displayColor = [(1, 0, 1)]
        double radius = 0.5
        double3 xformOp:translate = (4.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "TorusPlaceholder"
    {
        double3 xformOp:translate = (7.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "Sphere"
        {
            color3f[] primvars:displayColor = [(0, 1, 1)]
            double radius = 0.8
        }
    }
}

